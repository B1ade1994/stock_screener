<div data-controller="level-visibility"
     data-level-visibility-url-value="<%= instrument_price_level_path(instrument, level) %>"
     data-level-visibility-id-value="<%= level.id %>"
     data-level-visibility-visible-value="<%= level.chart_visible? %>">
  <button type="button" class="level-visibility-button" data-level-visibility-target="button" data-action="level-visibility#toggle"
          aria-pressed="<%= level.chart_visible? %>" aria-label="<%= level.chart_visible? ? 'Скрыть уровень на графике' : 'Показать уровень на графике' %>"
          title="<%= level.chart_visible? ? 'Скрыть на графике' : 'Показать на графике' %>">
    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z"/>
      <circle cx="12" cy="12" r="3"/>
      <path d="M3 3 21 21" data-level-visibility-target="slash" display="<%= level.chart_visible? ? 'none' : 'inline' %>"/>
    </svg>
  </button>
  <small class="autosave-error" role="alert" data-level-visibility-target="error"></small>
</div>
