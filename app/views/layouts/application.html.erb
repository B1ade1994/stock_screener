<!DOCTYPE html>
<html lang="ru">
  <head>
    <title><%= content_for?(:title) ? yield(:title) : "Stock Screener · Рыночный радар" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %><%= csp_meta_tag %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body>
    <aside class="sidebar">
      <a class="brand" href="/"><span class="brand-icon">⌁</span><span>stock<span class="muted">screener</span></span></a>
      <div class="nav-label">РАБОЧЕЕ ПРОСТРАНСТВО</div>
      <%= link_to "◉  Обзор рынка", root_path, class: "nav-link" %>
      <%= link_to "＋  Добавить инструмент", search_instruments_path, class: "nav-link" %>
      <%= link_to "FAQ", guide_path, class: "nav-link guide-link", aria: { current: current_page?(guide_path) ? "page" : nil } %>
      <div class="sidebar-note"><span class="dot"></span> Т-Инвестиции API<br><small>Акции и фьючерсы · Только чтение</small></div>
    </aside>
    <main>
      <header class="topbar"><span>РЫНОЧНЫЙ РАДАР</span><span>MOEX <span class="separator">/</span> MSK</span></header>
      <% flash.each do |type, text| %><div class="flash <%= type %>" role="status"><%= text %></div><% end %>
      <%= yield %>
      <footer>Объёмы — минутные события. Уровни — дневной и недельный контекст.</footer>
    </main>
  </body>
</html>
