<%= turbo_frame_tag "instrument-chart", data: { turbo_action: "advance" } do %>
  <section class="panel padded" data-controller="chart-strength-filter" data-chart-strength-filter-instrument-value="<%= @instrument.id %>" data-action="click@window->chart-strength-filter#outside keydown.esc@window->chart-strength-filter#close turbo:before-cache@document->chart-strength-filter#close">
    <div class="panel-heading flush chart-heading">
      <div>
        <h2><%= @timeframe == 'week' ? 'Недельный контекст' : 'Дневной контекст' %></h2>
        <span class="muted">Загружено завершённых свечей: <%= @candles.size %> · цены <%= @instrument.future? ? 'в пунктах' : @instrument.currency.upcase %></span>
        <% if @candles.any?(&:reference?) %><p class="muted">Ранняя история дополнена SPY. Объёмы фьючерса доступны только для собственных свечей SP500F.</p><% end %>
      </div>
      <div class="chart-tools">
        <% if @candles.any? %>
          <details class="chart-strength-choice" data-chart-strength-filter-target="menu">
            <summary data-chart-strength-filter-target="summary">Сила: высокая</summary>
            <div class="chart-strength-options" role="group" aria-label="Сила уровней на графике">
              <label class="strength-select-all"><input type="checkbox" data-chart-strength-filter-target="all" data-action="change->chart-strength-filter#toggleAll">Все уровни</label>
              <% { '3' => 'Высокая', '2' => 'Средняя', '1' => 'Низкая', 'unrated' => 'Без оценки / предварительные' }.each do |value, label| %>
                <label><input type="checkbox" value="<%= value %>" <%= 'checked' if value == '3' %> data-chart-strength-filter-target="choice" data-action="change->chart-strength-filter#change"><%= label %></label>
              <% end %>
            </div>
          </details>
        <% end %>
      <nav class="chart-periods" aria-label="Период свечей" data-controller="chart-period" data-chart-period-chart-cursor-outlet="#instrument-chart [data-controller='chart-cursor']">
        <% { 'day' => 'День · 1D', 'week' => 'Неделя · 1W' }.each do |timeframe, label| %>
          <%= link_to label, instrument_path(@instrument, timeframe: timeframe), class: "button #{@timeframe == timeframe ? 'primary' : 'secondary'}", aria: { current: @timeframe == timeframe ? 'page' : nil }, data: { action: "click->chart-period#select", chart_period_timeframe_param: timeframe } %>
        <% end %>
      </nav>
      </div>
    </div>
    <% if @candles.any? %>
      <%
        prices = @candles.flat_map { |candle| [candle.low.to_f, candle.high.to_f] } + @levels.flat_map { |level| [level.lower_bound.to_f, level.upper_bound.to_f] } + @ema_series.values.flatten.compact
        minimum, maximum = prices.minmax
        padding = [(maximum - minimum) * 0.04, maximum.abs * 0.001, 0.000000001].max
        low = minimum - padding
        high = maximum + padding
        range = high - low
        step = 900.0 / @candles.size
        max_volume = @candles.filter_map(&:volume).max || 0
        y = ->(value) { 280 - (value.to_f - low) / range * 240 }
      %>
      <div class="chart-interaction" data-controller="chart-cursor" data-chart-cursor-quote-url-value="<%= quote_instrument_path(@instrument) %>" data-chart-cursor-last-price-value="<%= @instrument.last_price %>" data-chart-cursor-last-trade-at-value="<%= @instrument.last_trade_at&.iso8601 %>" data-chart-cursor-start-index-value="<%= @chart_start_index %>" data-chart-cursor-low-value="<%= low %>" data-chart-cursor-high-value="<%= high %>" data-action="turbo:before-cache@document->chart-cursor#prepareForCache">
      <svg class="chart" viewBox="0 24 1000 436" role="img" tabindex="0" aria-label="<%= @timeframe == 'week' ? 'Недельные' : 'Дневные' %> свечи, объёмы и все активные уровни" data-timeframe="<%= @timeframe %>" data-chart-cursor-target="svg"
        data-action="pointerdown->chart-cursor#startDrag pointermove->chart-cursor#move pointerup->chart-cursor#finishDrag pointercancel->chart-cursor#finishDrag lostpointercapture->chart-cursor#finishDrag pointerleave->chart-cursor#hide dblclick->chart-cursor#reset keydown->chart-cursor#key scroll@window->chart-cursor#hide resize@window->chart-cursor#hide">
        <defs>
          <clipPath id="chart-price-clip-<%= @instrument.id %>-<%= @timeframe %>"><rect x="0" y="40" width="900" height="240"/></clipPath>
          <clipPath id="chart-volume-clip-<%= @instrument.id %>-<%= @timeframe %>"><rect x="0" y="320" width="900" height="80"/></clipPath>
        </defs>
        <rect x="0" y="40" width="900" height="360" fill="transparent" pointer-events="all"/>
        <% 5.times do |i| %>
          <% price = low + range * i / 4 %>
          <line x1="0" x2="910" y1="<%= y.call(price) %>" y2="<%= y.call(price) %>" stroke="#e8edf2"/>
          <text data-chart-cursor-target="priceTick" data-y="<%= y.call(price) %>" x="918" y="<%= y.call(price) + 4 %>" fill="#718096" font-size="11"><%= number_with_precision(price, precision: 1, strip_insignificant_zeros: true, separator: ',', delimiter: ' ') %></text>
        <% end %>
        <g clip-path="url(#chart-price-clip-<%= @instrument.id %>-<%= @timeframe %>)">
        <g class="chart-price-content" data-chart-cursor-target="pricePlot">
        <% @candles.each_with_index do |candle, i| %>
          <% x = i * step + step / 2; color = candle.close >= candle.open ? '#168779' : '#cb6b64' %>
          <g class="chart-candle" data-time="<%= candle.time.iso8601 %>" data-date="<%= candle.time.strftime('%d.%m.%Y') %>" data-volume="<%= candle.volume %>" data-source="<%= candle.data_source %>">
            <title><%= candle.time.strftime('%d.%m.%Y') %> · <%= candle.source_label %> · O <%= candle.open %> H <%= candle.high %> L <%= candle.low %> C <%= candle.close %></title>
            <line x1="<%= x %>" x2="<%= x %>" y1="<%= y.call(candle.high) %>" y2="<%= y.call(candle.low) %>" stroke="<%= color %>"/>
            <rect x="<%= x - [step * 0.3, 8].min %>" y="<%= [y.call(candle.open), y.call(candle.close)].min %>" width="<%= [step * 0.6, 16].min %>" height="<%= [(y.call(candle.open) - y.call(candle.close)).abs, 1].max %>" fill="<%= color %>"/>
          </g>
        <% end %>
        <% @ema_series.each_with_index do |(period, values), series_index| %>
          <% points = values.each_with_index.filter_map { |value, i| value && "#{i * step + step / 2},#{y.call(value)}" } %>
          <% if points.any? %>
            <polyline class="chart-ema" data-period="<%= period %>" points="<%= points.join(' ') %>" fill="none" stroke="#465466" stroke-width="1.4" stroke-dasharray="<%= ['', '8 4', '2 4'][series_index] %>"><title>EMA<%= period %></title></polyline>
          <% end %>
        <% end %>
        <% @levels.each do |level| %>
          <% strength = @level_strength.call(level); initially_visible = level.chart_visible? && strength.grade == 3 %>
          <g data-chart-level-id="<%= level.id %>" data-level-strength="<%= strength.grade || 'unrated' %>" data-chart-visible="<%= level.chart_visible? %>" display="<%= initially_visible ? 'inline' : 'none' %>">
          <% if level.upper_bound > level.lower_bound %>
            <rect class="chart-zone" data-level-id="<%= level.id %>" x="0" width="900" y="<%= y.call(level.upper_bound) %>" height="<%= y.call(level.lower_bound) - y.call(level.upper_bound) %>" fill="<%= level.timeframe == 'week' ? '#9363b8' : '#658bb4' %>" fill-opacity="<%= level.status == 'candidate' ? '0.05' : '0.12' %>">
              <title><%= number_with_precision(level.lower_bound, precision: 1, strip_insignificant_zeros: true, separator: ',', delimiter: ' ') %>–<%= number_with_precision(level.upper_bound, precision: 1, strip_insignificant_zeros: true, separator: ',', delimiter: ' ') %> · <%= level_status_label(level.status) %></title>
            </rect>
          <% end %>
          <line class="chart-level" data-level-id="<%= level.id %>" x1="0" x2="900" y1="<%= y.call(level.price) %>" y2="<%= y.call(level.price) %>" stroke="<%= level.timeframe == 'week' ? '#9363b8' : '#658bb4' %>" stroke-width="1.5" stroke-dasharray="<%= level.timeframe == 'week' ? '9 4' : '4 4' %>">
            <title><%= level.timeframe == 'week' ? '1W' : '1D' %> · <%= level.side == 'support' ? 'Поддержка' : 'Сопротивление' %> · <%= number_with_precision(level.price, precision: 1, strip_insignificant_zeros: true, separator: ',', delimiter: ' ') %> · Сила: <%= strength.label %></title>
          </line>
          </g>
        <% end %>
        </g></g>
        <text x="0" y="307" fill="#718096" font-size="11">Объём свечи, лоты</text>
        <line x1="0" x2="910" y1="320" y2="320" stroke="#e8edf2"/>
        <line x1="0" x2="910" y1="400" y2="400" stroke="#e8edf2"/>
        <text x="918" y="324" fill="#718096" font-size="10"><%= number_with_delimiter(max_volume, delimiter: ' ') %></text>
        <text x="918" y="404" fill="#718096" font-size="10">0</text>
        <g clip-path="url(#chart-volume-clip-<%= @instrument.id %>-<%= @timeframe %>)">
        <g data-chart-cursor-target="volumePlot">
        <% @candles.each_with_index do |candle, i| %>
          <% x = i * step + step / 2; height = max_volume.positive? && candle.volume ? candle.volume.to_f / max_volume * 80 : 0 %>
          <rect class="chart-volume" data-volume="<%= candle.volume %>" data-source="<%= candle.data_source %>" x="<%= x - [step * 0.3, 8].min %>" y="<%= 400 - height %>" width="<%= [step * 0.6, 16].min %>" height="<%= height %>" fill="<%= candle.close >= candle.open ? '#168779' : '#cb6b64' %>">
            <title><%= candle.time.strftime('%d.%m.%Y') %> · <%= candle.volume.nil? ? 'SPY · объём SP500F недоступен' : "Объём #{number_with_delimiter(candle.volume, delimiter: ' ')} лот. · цвет по направлению свечи, не сторона сделок" %></title>
          </rect>
        <% end %>
        </g></g>
        <text data-chart-cursor-target="dateStart" x="0" y="435" fill="#718096" font-size="12"><%= @candles.first.time.strftime('%d.%m.%Y') %></text>
        <text data-chart-cursor-target="dateEnd" x="900" y="435" text-anchor="end" fill="#718096" font-size="12"><%= @candles.last.time.strftime('%d.%m.%Y') %></text>
        <g class="chart-current-price" data-chart-cursor-target="currentPrice" display="none" role="img" aria-label="Цена последней сделки">
          <title data-chart-cursor-target="currentPriceTitle">Цена последней сделки</title>
          <line data-chart-cursor-target="currentPriceLine" x1="0" x2="912" y1="0" y2="0" stroke="#168779" stroke-width="1" stroke-dasharray="3 3" pointer-events="none"/>
          <rect data-chart-cursor-target="currentPriceLabel" x="912" y="-11" width="82" height="22" rx="3" fill="#168779"/>
          <text data-chart-cursor-target="currentPriceText" x="953" y="0" text-anchor="middle" dominant-baseline="central" fill="#fff" font-size="11"></text>
        </g>
        <g class="chart-cursor" data-chart-cursor-target="cursor" visibility="hidden" pointer-events="none" aria-hidden="true">
          <text data-chart-cursor-target="volume" x="230" y="307" fill="#34515e" font-size="11"></text>
          <g data-chart-cursor-target="horizontal">
          <line data-chart-cursor-target="line" x1="0" x2="912" y1="0" y2="0" stroke="#34515e" stroke-width="1" stroke-dasharray="4 3"/>
          <rect data-chart-cursor-target="label" x="912" y="-12" width="82" height="24" rx="4" fill="#172e3b"/>
          <text data-chart-cursor-target="price" x="953" y="0" text-anchor="middle" dominant-baseline="central" fill="#fff" font-size="11"></text>
          </g>
          <line data-chart-cursor-target="vertical" x1="0" x2="0" y1="40" y2="420" stroke="#34515e" stroke-width="1" stroke-dasharray="4 3"/>
          <rect data-chart-cursor-target="dateLabel" x="0" y="420" width="92" height="24" rx="4" fill="#172e3b"/>
          <text data-chart-cursor-target="date" x="46" y="432" text-anchor="middle" dominant-baseline="central" fill="#fff" font-size="11"></text>
        </g>
      </svg>
      </div>
      <p class="muted chart-trend">EMA: <%= @ema_series.keys.each_with_index.map { |period, index| "#{period} — #{['сплошная', 'штриховая', 'точечная'][index]}" }.join(' · ') %>. <%= trend_description(@trend) %>.</p>
      <div class="chart-legend"><span class="daily-level">Уровни 1D</span><span class="weekly-level">Уровни 1W</span><span>Активные уровни и зоны: <%= @levels.size %>.</span></div>
    <% else %>
      <div class="empty compact"><p><%= @timeframe == 'week' ? 'Недельные' : 'Дневные' %> свечи ещё не загружены. Нажмите «Обновить историю» и обновите страницу после загрузки.</p></div>
    <% end %>
  </section>
<% end %>
