<div class="page-heading"><div><%= link_to '← Обзор рынка', root_path, class: 'back-link' %><h1><%= @instrument.ticker %> <span class="badge"><%= @instrument.future? ? 'Фьючерс' : 'Акция' %></span></h1><p><%= @instrument.name %> · <%= @instrument.class_code %><% if @instrument.future? %> · Экспирация <%= @instrument.expiration_date %><% end %></p></div><%= button_to 'Обновить историю', refresh_instrument_path(@instrument), class: 'button secondary' %></div>
<% if @instrument.history_error %><div class="flash alert"><%= @instrument.history_error %></div><% end %>
<%= render "chart" %>
<div class="two-columns"><section class="panel padded"><h2>Аномальный объём · 1 мин</h2><p class="muted">Сравнение с медианой 20 предыдущих полных минут. После разрыва соединения прогрев начинается заново.</p><%= form_with model: @instrument, class: "settings-form" do |f| %><%= f.label :volume_multiplier, 'Во сколько раз выше обычного' %><%= f.number_field :volume_multiplier, min: 1.5, max: 100, step: 0.5 %><%= f.label :minimum_volume, "Минимальный объём, #{@instrument.volume_unit}" %><%= f.number_field :minimum_volume, min: 1 %><%= f.submit 'Сохранить', class: 'button secondary' %><% end %></section>
<section class="panel padded"><h2>Добавить свой уровень</h2><p class="muted">Пересечение — раннее событие. Подтверждение — закрытие дневной или недельной свечи за уровнем с буфером 0,1%.</p><%= form_with scope: :price_level, url: instrument_price_levels_path(@instrument), class: 'settings-form' do |f| %><%= f.label :price, 'Цена уровня' %><%= f.number_field :price, min: 0.000000001, step: :any, required: true %><div class="form-row"><%= f.select :timeframe, [['Дневной · 1D', 'day'], ['Недельный · 1W', 'week']] %><%= f.select :side, [['Сопротивление', 'resistance'], ['Поддержка', 'support']] %></div><%= f.submit 'Добавить уровень', class: 'button primary' %><% end %></section></div>
<%= render "levels" %>
<section class="panel"><div class="panel-heading"><h2>События инструмента</h2></div><%= render 'signals/list', signals: @signals %></section><div class="danger-zone"><%= button_to 'Удалить инструмент из наблюдения', instrument_path(@instrument), method: :delete, class: 'text-button', data: { turbo_confirm: 'Удалить инструмент и его историю сигналов?' } %></div>
