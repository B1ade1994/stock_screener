<div class="page-heading"><div><div class="eyebrow">СПИСОК НАБЛЮДЕНИЯ</div><h1>Добавить инструмент</h1><p>Поиск напрямую в каталоге Т-Инвестиций.</p></div></div>
<section class="panel padded"><%= form_with url: search_instruments_path, method: :get, class: "search-form" do |f| %><%= f.text_field :q, value: @query, placeholder: "Тикер или название, например SBER", required: true, maxlength: 80, aria: { label: 'Тикер или название' }, autofocus: true %><%= f.submit "Найти", class: "button primary" %><% end %></section>
<% if @query.present? %><section class="panel"><div class="panel-heading"><h2>Результаты поиска</h2></div><% if @results.empty? %><div class="empty"><p>Акции или фьючерсы по этому запросу не найдены.</p></div><% end %>
<% @results.each do |item| %><div class="search-result"><div><strong><%= item['ticker'] %></strong><span class="badge"><%= item['instrumentType'] == 'futures' ? 'Фьючерс' : 'Акция' %> · <%= item['classCode'] %></span><p><%= item['name'] %></p></div><%= button_to 'Добавить', instruments_path, params: { uid: item['uid'] }, class: "button secondary" %></div><% end %></section><% end %>
