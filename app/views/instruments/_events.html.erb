<%= turbo_frame_tag 'instrument-signals', data: { controller: 'refresh', refresh_interval_value: 5000, refresh_url_value: events_instrument_path(@instrument), action: 'turbo:submit-start->refresh#invalidate turbo:before-frame-render->refresh#beforeRender' } do %>
  <section class="panel"><div class="panel-heading"><h2>События инструмента</h2></div><%= render 'signals/list', signals: @signals %></section>
<% end %>
