<div class="signal-list">
<% signals.each do |signal| %><article class="signal" id="<%= dom_id(signal) %>"><div class="signal-symbol"><%= signal.kind == 'volume' ? '↗' : '⌁' %></div><div class="signal-content"><div><%= link_to signal.instrument.ticker, instrument_path(signal.instrument), class: "ticker", data: { turbo_frame: "_top" } %><span class="badge <%= signal.kind == 'crossing' ? 'amber' : '' %>"><%= { 'volume' => 'Объём', 'crossing' => 'Раннее событие', 'confirmed' => 'Закрытие свечи', 'failed_breakout' => 'Возврат в зону', 'retest' => 'Ретест', 'held_breakout' => 'Удержание' }[signal.kind] %></span></div><h3><%= signal.title %></h3>
<% d = signal.details %><p><% if signal.kind == 'volume' %><%= d['volume'] %> <%= signal.instrument.volume_unit %> · обычный объём <%= d['baseline'] %> · BUY <%= d['buy'] %> / SELL <%= d['sell'] %> / неизвестно <%= d['unknown'] %><% else %><%= d['side'] == 'support' ? 'Поддержка' : 'Сопротивление' %> <%= d['lower'] && d['upper'] ? "#{d['lower']}–#{d['upper']}" : d['level'] %> · цена <%= d['price'] || d['close'] %><% if d['confirmation'] %> · <%= d['confirmation'] %><% end %><% end %></p><% if d["trend"].present? %><p class="muted"><%= trend_description(d["trend"]) %></p><% end %></div><div class="signal-actions"><time><%= signal.occurred_at.in_time_zone.strftime('%d.%m %H:%M') %></time>
<%= button_to signal_path(signal), method: :delete, class: "signal-delete-button", title: "Удалить событие", aria: { label: "Удалить событие #{signal.instrument.ticker}: #{signal.title}" } do %>
  <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M3 6h18M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2M5 6l1 14a1 1 0 0 0 1 1h10a1 1 0 0 0 1-1l1-14M10 10v7M14 10v7"/>
  </svg>
<% end %>
</div></article><% end %>
<div class="empty compact"><h3>Пока без событий</h3><p>Объёму нужна 21 полная минута непрерывного наблюдения.<br>Пробои отслеживаются относительно дневных и недельных уровней.</p></div>
</div>
