<% if signals.empty? %><div class="empty compact"><h3>Пока без событий</h3><p>Объёму нужна 21 полная минута непрерывного наблюдения.<br>Пробои отслеживаются относительно дневных и недельных уровней.</p></div><% else %>
<% signals.each do |signal| %><article class="signal"><div class="signal-symbol"><%= signal.kind == 'volume' ? '↗' : '⌁' %></div><div class="signal-content"><div><%= link_to signal.instrument.ticker, instrument_path(signal.instrument), class: "ticker", data: { turbo_frame: "_top" } %><span class="badge <%= signal.kind == 'crossing' ? 'amber' : '' %>"><%= { 'volume' => 'Объём', 'crossing' => 'Раннее событие', 'confirmed' => 'Закрытие свечи', 'failed_breakout' => 'Возврат в зону', 'retest' => 'Ретест', 'held_breakout' => 'Удержание' }[signal.kind] %></span></div><h3><%= signal.title %></h3>
<% d = signal.details %><p><% if signal.kind == 'volume' %><%= d['volume'] %> <%= signal.instrument.volume_unit %> · обычный объём <%= d['baseline'] %> · BUY <%= d['buy'] %> / SELL <%= d['sell'] %> / неизвестно <%= d['unknown'] %><% else %><%= d['side'] == 'support' ? 'Поддержка' : 'Сопротивление' %> <%= d['lower'] && d['upper'] ? "#{d['lower']}–#{d['upper']}" : d['level'] %> · цена <%= d['price'] || d['close'] %><% if d['confirmation'] %> · <%= d['confirmation'] %><% end %><% end %></p><% if d["trend"].present? %><p class="muted"><%= trend_description(d["trend"]) %></p><% end %></div><time><%= signal.occurred_at.in_time_zone.strftime('%d.%m %H:%M') %></time></article><% end %><% end %>
