<% [signal.reaction, signal.confirmation_reaction].compact.each do |reaction| %>
  <div class="signal-reaction">
    <p class="muted"><%= reaction.phase == "confirmation" ? "После подтверждения" : (signal.kind == "directional_hint" ? "После регистрации кандидата" : "После уведомления") %> · отсчёт <%= reaction.reference_at.in_time_zone.strftime('%d.%m %H:%M') %><% if reaction.reference_price %> · цена <%= number_with_precision(reaction.reference_price, precision: 4, strip_insignificant_zeros: true) %><% end %></p>
    <div class="reaction-outcomes">
      <% local_assigns.fetch(:horizons, SignalReaction::HORIZONS).each do |minutes| %>
        <% result = reaction.results[minutes.to_s] %>
        <% if result && result['status'] == 'measured' %>
          <% change = result.fetch('change_percent') %>
          <span class="reaction-outcome <%= change.positive? ? 'price-up' : change.negative? ? 'price-down' : '' %>"
                title="Цена <%= result.fetch('price') %>; максимум <%= signed_percent(result.fetch('high_percent')) %>, минимум <%= signed_percent(result.fetch('low_percent')) %>; свечей <%= result.fetch('candles') %>/<%= minutes %>">
            <%= minutes %> мин: <strong><%= signed_percent(change) %></strong><% if result.fetch("candles").to_i != minutes %> <small>неполные данные · <%= result.fetch("candles") %>/<%= minutes %><% if reaction.next_check_at && Time.current < reaction.recovery_deadline(minutes) %> · повторим загрузку<% end %></small><% elsif result['recovered_at'] %> <small>данные восстановлены</small><% end %>
          </span>
        <% elsif result %>
          <span class="reaction-outcome" title="<%= result.fetch('reason', 'Причина не сохранена') %>"><%= minutes %> мин: <%= SignalReaction::QUALITY_LABELS.fetch(reaction.quality_code(result, minutes)) %><% if reaction.next_check_at && Time.current < reaction.recovery_deadline(minutes) %> · повторим загрузку<% end %></span>
        <% else %>
          <span class="reaction-outcome"><%= minutes %> мин: <%= Time.current >= reaction.reference_at + minutes.minutes + SignalReaction::SETTLE_DELAY ? 'срок наступил, ожидаем запись' : 'ожидаем' %></span>
        <% end %>
      <% end %>
    </div>
    <% if reaction.last_error.present? %><p class="muted">История временно недоступна. Повторим загрузку.</p><% end %>
  </div>
<% end %>
<% if signal.kind == 'reversal' && signal.reversal_status == 'confirmed' && signal.confirmed_at.nil? %>
  <p class="muted">После подтверждения: нет сохранённого отсчёта для старого события.</p>
<% end %>
