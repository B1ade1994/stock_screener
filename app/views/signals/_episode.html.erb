<% totals = signal.details.fetch("totals") %>
<p>Всплесков: <strong><%= signal.details.fetch("burst_count") %></strong> ·
  <%= signal.occurred_at.in_time_zone.strftime('%H:%M') %>–<%= signal.last_occurred_at.in_time_zone.strftime('%H:%M') %> ·
  в аномальных минутах <%= number_with_delimiter(totals.fetch("volume")) %> <%= signal.instrument.volume_unit %>
</p>
<p>BUY <%= number_with_delimiter(totals.fetch("buy")) %> / SELL <%= number_with_delimiter(totals.fetch("sell")) %> / неизвестно <%= number_with_delimiter(totals.fetch("unknown")) %></p>
<details class="episode-bursts">
  <summary>Минутные всплески</summary>
  <div class="table-scroll"><table>
    <thead><tr><th>МСК</th><th>Объём, лоты</th><th>Медиана 20 мин</th><th>× к 20 мин</th><th>То же время прошлых сессий</th><th>BUY / SELL / ?</th></tr></thead>
    <tbody><% signal.details.fetch("bursts").each do |burst| %>
      <tr><td><%= Time.iso8601(burst.fetch("time")).in_time_zone.strftime('%H:%M') %></td>
        <td><%= number_with_delimiter(burst.fetch("volume")) %></td><td><%= burst.fetch("baseline") %></td><td>×<%= burst.fetch("ratio") %></td>
        <td><% baseline = burst.dig("quality", "time_baseline") %>
          <% if baseline&.fetch("status") == "ready" %>
            <%= number_with_delimiter(baseline.fetch("baseline")) %> лот. · ×<%= baseline.fetch("ratio") %> · <%= baseline.fetch("samples") %> сессий
          <% elsif baseline %>
            <%= baseline["status"] == "zero_baseline" ? "Нулевая медиана — без оценки" : "Набираем базу: #{baseline['samples']}/#{baseline['minimum_samples']}" %>
          <% else %>Нет оценки<% end %>
        </td>
        <td><%= burst.fetch("buy") %> / <%= burst.fetch("sell") %> / <%= burst.fetch("unknown") %></td></tr>
    <% end %></tbody>
  </table></div>
</details>
